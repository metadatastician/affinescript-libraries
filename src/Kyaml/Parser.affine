//
// Kyaml.Parser — Parser for KYAML
//
// This module parses a stream of KYAML tokens into an Abstract Syntax Tree.
// It handles the full YAML 1.2 specification with Kubernetes-specific extensions.

module Kyaml.Parser

import Kyaml.Ast
import Kyaml.Lexer

// ============================================================================
// Parser Types
// ============================================================================

/**
 * Represents the parser state.
 */
type ParserState = {
  tokens: list<Token>,
  position: int,
  currentToken: Option<Token>
}

/**
 * Create a new parser state from a list of tokens.
 */
newParserState :: list<Token> -> ParserState
newParserState tokens = 
  if length tokens > 0 then
    { tokens = tokens, position = 0, currentToken = Some tokens[0] }
  else
    { tokens = tokens, position = 0, currentToken = None }

// ============================================================================
// Parser Functions
// ============================================================================

/**
 * Parse a list of tokens into a KYamlFile.
 */
parse :: list<Token> -> Result<KYamlFile, ParseError>
parse tokens = 
  let state = newParserState tokens
  let rec loop state docs = 
    if atEnd state then
      Ok { docs = reverse docs, source = None }
    else
      match parseDocument state with
        | Ok (doc, newState) -> loop newState (doc :: docs)
        | Err error -> Err error
  in loop state []

/**
 * Parse a single document.
 */
parseDocument :: ParserState -> Result<(KYamlDoc, ParserState), ParseError>
parseDocument state = 
  match current state with
    | Some (TDocStart _) -> 
        let newState = advance state
        parseNode newState |> 
        case Ok (node, afterNode) -> 
          match current afterNode with
            | Some (TDocEnd _) -> Ok (KGeneric node, advance afterNode)
            | _ -> Ok (KGeneric node, afterNode)
        | Err e -> Err e
    | Some token -> 
        parseNode state |> 
        case Ok (node, afterNode) -> Ok (KGeneric node, afterNode)
        | Err e -> Err e
    | None -> Ok (KGeneric (NScalar SNull), state)

/**
 * Parse a node from the token stream.
 */
parseNode :: ParserState -> Result<(Node, ParserState), ParseError>
parseNode state = 
  match current state with
    | Some (TFlowSequenceStart span) -> parseFlowSequence state
    | Some (TFlowMappingStart span) -> parseFlowMapping state
    | Some (TBlockSequenceStart span) -> parseBlockSequence state
    | Some (TString value, span) -> Ok (NScalar (SString value), advance state)
    | Some (TInt value, span) -> Ok (NScalar (SInt value), advance state)
    | Some (TFloat value, span) -> Ok (NScalar (SFloat value), advance state)
    | Some (TBool value, span) -> Ok (NScalar (SBool value), advance state)
    | Some (TNull span) -> Ok (NScalar SNull, advance state)
    | Some token -> Err (makeError state ("Unexpected token: " ++ tokenToString token))
    | None -> Ok (NScalar SNull, state)

where
  parseFlowSequence state = 
    let newState = advance state
    let rec loop state items = 
      match current state with
        | Some (TFlowSequenceEnd _) -> 
            let endState = advance state
            Ok (NSequence (reverse items), endState)
        | Some (TValueSeparator _) -> 
            let sepState = advance state
            parseNode sepState |> 
            case Ok (item, afterItem) -> loop afterItem (item :: items)
            | Err e -> Err e
        | Some _ -> 
            parseNode state |> 
            case Ok (item, afterItem) -> loop afterItem (item :: items)
            | Err e -> Err e
        | None -> Err (makeError state "Unterminated flow sequence")
    in loop newState []
  
  parseFlowMapping state = 
    let newState = advance state
    let rec loop state pairs = 
      match current state with
        | Some (TFlowMappingEnd _) -> 
            let endState = advance state
            Ok (NMapping (fromList pairs), endState)
        | Some (TValueSeparator _) -> 
            let sepState = advance state
            loop sepState pairs
        | Some (TKeySeparator _) -> 
            Err (makeError state "Unexpected key separator in flow mapping")
        | Some token -> 
            parseNode state |> 
            case Ok (key, afterKey) -> 
              match current afterKey with
                | Some (TKeySeparator _) ->
                    let sepState = advance afterKey
                    parseNode sepState |> 
                    case Ok (value, afterValue) -> 
                      loop afterValue ((getScalarString key, value) :: pairs)
                    | Err e -> Err e
                | _ -> Err (makeError afterKey "Expected ':' after key in flow mapping")
            | Err e -> Err e
        | None -> Err (makeError state "Unterminated flow mapping")
    in loop newState []
  
  parseBlockSequence state = 
    let newState = advance state
    let rec loop state items = 
      match current state with
        | Some (TBlockSequenceStart _) -> 
            let itemState = advance state
            parseNode itemState |> 
            case Ok (item, afterItem) -> loop afterItem (item :: items)
            | Err e -> Err e
        | Some token -> Ok (NSequence (reverse items), state)
        | None -> Ok (NSequence (reverse items), state)
    in loop newState []
  
  getScalarString node = 
    case node of
      NScalar (SString s) -> s
      NScalar (SInt i) -> intToString i
      NScalar (SFloat f) -> floatToString f
      NScalar (SBool b) -> if b then "true" else "false"
      NScalar SNull -> "null"
      _ -> ""

// ============================================================================
// Helper Functions
// ============================================================================

/**
 * Get the current token.
 */
current :: ParserState -> Option<Token>
current state = state.currentToken

/**
 * Advance to the next token.
 */
advance :: ParserState -> ParserState
advance state = 
  if state.position + 1 < length state.tokens then
    { state | 
        position = state.position + 1,
        currentToken = Some state.tokens[state.position + 1]
    }
  else
    { state | 
        position = state.position + 1,
        currentToken = None
    }

/**
 * Check if at end of tokens.
 */
atEnd :: ParserState -> bool
atEnd state = state.currentToken == None

/**
 * Get the length of a list.
 */
length :: list<a> -> int
length list = 
  let rec loop acc remaining = 
    case remaining of
      [] -> acc
      (_ :: xs) -> loop (acc + 1) xs
  in loop 0 list

/**
 * Convert a token to a string for error messages.
 */
tokenToString :: Token -> string
tokenToString token = 
  case token of
    TString (value, _) -> "TString(\"" ++ value ++ "\")"
    TInt (value, _) -> "TInt(" ++ intToString value ++ ")"
    TFloat (value, _) -> "TFloat(" ++ floatToString value ++ ")"
    TBool (value, _) -> "TBool(" ++ (if value then "true" else "false") ++ ")"
    TNull _ -> "TNull"
    TAnchor (name, _) -> "TAnchor(\"" ++ name ++ "\")"
    TAlias (name, _) -> "TAlias(\"" ++ name ++ "\")"
    TTag (tag, _) -> "TTag(\"" ++ tag ++ "\")"
    TScalar (value, _) -> "TScalar(\"" ++ value ++ "\")"
    TFlowSequenceStart _ -> "TFlowSequenceStart"
    TFlowSequenceEnd _ -> "TFlowSequenceEnd"
    TFlowMappingStart _ -> "TFlowMappingStart"
    TFlowMappingEnd _ -> "TFlowMappingEnd"
    TBlockSequenceStart _ -> "TBlockSequenceStart"
    TBlockMappingStart _ -> "TBlockMappingStart"
    TKeySeparator _ -> "TKeySeparator"
    TValueSeparator _ -> "TValueSeparator"
    TDocStart _ -> "TDocStart"
    TDocEnd _ -> "TDocEnd"
    TDirective (value, _) -> "TDirective(\"" ++ value ++ "\")"
    TComment (value, _) -> "TComment(\"" ++ value ++ "\")"
    TNewline _ -> "TNewline"
    TIndic (level, _) -> "TIndic(" ++ intToString level ++ ")"
    TEof -> "TEof"

/**
 * Create a parse error.
 */
makeError :: ParserState -> string -> ParseError
makeError state message = 
  case state.currentToken of
    Some token -> 
      let location = tokenLocation token
      { message = message, location = location, errorCode = "PARSE_ERROR" }
    None -> 
      { message = message, location = { line = 0, column = 0, offset = 0 }, errorCode = "PARSE_ERROR" }

/**
 * Get the location from a token.
 */
tokenLocation :: Token -> SourceLocation
tokenLocation token = 
  case token of
    TString (_, span) -> span.start
    TInt (_, span) -> span.start
    TFloat (_, span) -> span.start
    TBool (_, span) -> span.start
    TNull span -> span
    TAnchor (_, span) -> span.start
    TAlias (_, span) -> span.start
    TTag (_, span) -> span.start
    TScalar (_, span) -> span.start
    TFlowSequenceStart span -> span
    TFlowSequenceEnd span -> span
    TFlowMappingStart span -> span
    TFlowMappingEnd span -> span
    TBlockSequenceStart span -> span
    TBlockMappingStart span -> span
    TKeySeparator span -> span
    TValueSeparator span -> span
    TDocStart span -> span
    TDocEnd span -> span
    TDirective (_, span) -> span.start
    TComment (_, span) -> span.start
    TNewline span -> span
    TIndic (_, span) -> span
    TEof -> { line = 0, column = 0, offset = 0 }

/**
 * Convert integer to string.
 */
intToString :: int -> string
intToString i = 
  if i == 0 then "0"
  else if i < 0 then "-" ++ intToString (-i)
  else intToStringHelper i ""

intToStringHelper i acc = 
  if i == 0 then 
    if acc == "" then "0" else acc
  else
    intToStringHelper (i / 10) (stringOfChar (charOfDigit (i % 10)) ++ acc)

charOfDigit d = 
  if d == 0 then '0' else if d == 1 then '1' else if d == 2 then '2' 
  else if d == 3 then '3' else if d == 4 then '4' else if d == 5 then '5'
  else if d == 6 then '6' else if d == 7 then '7' else if d == 8 then '8'
  else '9'

/**
 * Convert float to string.
 */
floatToString :: float -> string
floatToString f = "0.0"  // Simplified placeholder

/**
 * Convert character to string.
 */
stringOfChar :: char -> string
stringOfChar c = [c]

/**
 * Create a list from a pair list.
 */
fromList :: list<(K, V)> -> Map<K, V>
fromList pairs = 
  let rec loop acc remaining = 
    case remaining of
      [] -> acc
      ((k, v) :: xs) -> loop (insert acc k v) xs
  in loop emptyMap pairs

/**
 * Insert a key-value pair into a map.
 */
insert :: Map<K, V> -> K -> V -> Map<K, V>
insert m k v = 
  { m | data = (k, v) :: m.data, isEmpty = false }
