// Kyaml — Main module for Kubernetes YAML processing
//
// This is the main entry point for the KYAML library.
// It provides a high-level API for parsing, linting, and querying Kubernetes YAML.
//
// Part of: affinescript-libraries (https://github.com/metadatastician/affinescript-libraries)
// Used by: kcq (https://github.com/metadatastician/kcq)

module Kyaml

import Kyaml.Ast
import Kyaml.Lexer
import Kyaml.Parser
import Kyaml.Query
import Kyaml.Lint

// ============================================================================
// Public API Types
// ============================================================================

/**
 * Represents the result of parsing KYAML.
 */
type ParseResult
  = ParseSuccess of KYamlFile
  | ParseFailure of list<ParseError>

/**
 * Represents a complete KYAML file (possibly multi-document).
 */
type KYamlFile = {
  docs: list<KYamlDoc>,
  source: Option<string>  // Original source for error reporting
}

/**
 * Represents a single KYAML document.
 */
type KYamlDoc
  = KResource of KYamlResource
  | KGeneric of Node

/**
 * Represents a parsed Node in the AST.
 */
type Node
  = NScalar of Scalar
  | NSequence of list<Node>
  | NMapping of Map<string, Node>
  | NTag of string, Node
  | NAnchor of string, Node
  | NAlias of string

/**
 * Represents scalar values.
 */
type Scalar
  = SString of string
  | SInt of int
  | SFloat of float
  | SBool of bool
  | SNull
  | STimestamp of string

/**
 * Represents a Kubernetes resource.
 */
type KYamlResource = {
  apiVersion: string,
  kind: string,
  metadata: ResourceMetadata,
  spec: Node,
  status: Option<Node>
}

/**
 * Resource metadata.
 */
type ResourceMetadata = {
  name: string,
  namespace: Option<string>,
  labels: Map<string, string>,
  annotations: Map<string, string>,
  uid: Option<string>,
  generation: Option<int>,
  creationTimestamp: Option<string>,
  deletionTimestamp: Option<string>
}

/**
 * Represents a parse error.
 */
type ParseError = {
  message: string,
  location: SourceLocation,
  errorCode: string
}

/**
 * Source location for error reporting.
 */
type SourceLocation = {
  file: Option<string>,
  line: int,
  column: int,
  offset: int
}

// ============================================================================
// Public API Functions
// ============================================================================

/**
 * Parse KYAML from a string.
 * Returns ParseResult containing either the parsed KYamlFile or parse errors.
 */
parse :: string -> ParseResult
parse input = 
  Lexer.lex input |> 
  case Ok tokens of
    Parser.parse tokens -> 
      case parseResult of
        Ok file -> ParseSuccess file
        Err errors -> ParseFailure errors
    Err lexError -> ParseFailure [lexError]

/**
 * Parse KYAML from a file.
 */
parseFile :: string -> IO<ParseResult>
parseFile path = do
  content <- readFile path
  pure (parse content)

/**
 * Query a value from a KYAML file using a path expression.
 */
query :: string -> string -> Option<Node>
query input path = 
  case parse input of
    ParseSuccess file ->
      case file.docs of
        [] -> None
        (doc :: _) -> Kyaml.Query.query doc path
    ParseFailure _ -> None

/**
 * Set a value at a path in a KYAML document.
 * Returns a new KYAML string.
 */
set :: string -> string -> string -> string
set input path value = 
  case parse input of
    ParseSuccess file ->
      let newDocs = map (\doc -> Kyaml.Query.set doc path (parseValue value)) file.docs
      let newFile = { file | docs = newDocs }
      toYaml newFile
    ParseFailure _ -> input  // Return original on parse failure

/**
 * Delete a value at a path from a KYAML document.
 * Returns a new KYAML string.
 */
delete :: string -> string -> string
delete input path = 
  case parse input of
    ParseSuccess file ->
      let newDocs = map (\doc -> Kyaml.Query.delete doc path) file.docs
      let newFile = { file | docs = newDocs }
      toYaml newFile
    ParseFailure _ -> input

/**
 * Convert KYAML to YAML string.
 */
toYaml :: KYamlFile -> string
toYaml file = 
  join "\n---\n" (map docToYaml file.docs)

where
  docToYaml doc = 
    case doc of
      KResource resource -> resourceToYaml resource
      KGeneric node -> nodeToYaml node 0
  
  resourceToYaml resource = 
    let m = emptyMap
      .insert "apiVersion" (NScalar (SString resource.apiVersion))
      .insert "kind" (NScalar (SString resource.kind))
      .insert "metadata" (metadataToNode resource.metadata)
      .insert "spec" resource.spec
    in
      case resource.status of
        Some status -> nodeToYaml (NMapping (m.insert "status" status)) 0
        None -> nodeToYaml (NMapping m) 0
  
  metadataToNode metadata = 
    NMapping (emptyMap
      .insert "name" (NScalar (SString metadata.name))
      .insertIfSome "namespace" (metadata.namespace |> map (\ns -> NScalar (SString ns)))
      .insert "labels" (mapToNode metadata.labels)
      .insert "annotations" (mapToNode metadata.annotations)
    )
  
  mapToNode m = 
    NMapping (foldl (\acc, k, v -> acc.insert k (NScalar (SString v))) emptyMap m)
  
  insertIfSome m key optVal = 
    case optVal of
      Some val -> m.insert key val
      None -> m
  
  nodeToYaml node indentLevel = 
    let indent = repeat " " indentLevel
    let childIndent = repeat " " (indentLevel + 2)
    case node of
      NScalar scalar -> indent ++ scalarToYaml scalar
      NSequence list ->
        if list == [] then
          indent ++ "[]"
        else
          foldl (\acc, item -> acc ++ childIndent ++ "- " ++ nodeToYaml item (indentLevel + 4) ++ "\n") (indent ++ "\n") list
      NMapping m ->
        if m.isEmpty then
          indent ++ "{}"
        else
          foldl (\acc, k, v -> 
            acc ++ indent ++ k ++ ": " ++ 
            if isScalarOrEmpty v then
              nodeToYaml v (indentLevel + length k + 2)
            else
              "\n" ++ nodeToYaml v (indentLevel + 2)
            ++ "\n") "" m.toList
      _ -> "# Complex node"
  
  scalarToYaml scalar = 
    case scalar of
      SString s -> 
        if needsQuotes s then
          '\"' ++ escapeString s ++ '\"'
        else
          s
      SInt i -> intToString i
      SFloat f -> floatToString f
      SBool b -> if b then "true" else "false"
      SNull -> "null"
      STimestamp ts -> '\"' ++ ts ++ '\"'
  
  needsQuotes s = 
    s == "" || 
    s[0] == '#' || s[0] == '&' || s[0] == '*' || s[0] == '!' || 
    s[0] == '%' || s[0] == '@' || s[0] == '`' ||
    s[0] == '\"' || s[0] == "'" ||
    contains s ':' || contains s ' ' || contains s '\t' ||
    contains s '\n' || contains s '#' ||
    s == "true" || s == "false" || s == "null" || s == "~"
  
  escapeString s = 
    foldl (\acc, c -> 
      if c == '\"' then acc ++ "\\\""
      else if c == '\n' then acc ++ "\\n"
      else if c == '\t' then acc ++ "\\t"
      else acc ++ stringOfChar c) "" s
  
  isScalarOrEmpty node = 
    case node of
      NScalar _ -> true
      NSequence [] -> true
      NMapping m -> m.isEmpty
      _ -> false

/**
 * Lint a KYAML document.
 */
lint :: string -> list<LintIssue>
lint input = 
  case parse input of
    ParseSuccess file ->
      Kyaml.Lint.lintFile file
    ParseFailure _ -> []

/**
 * Validate a KYAML document against a schema.
 */
validate :: string -> string -> Result<list<string>, list<string>>
validate input schema = 
  Err ["Not yet implemented"]  // Placeholder

// ============================================================================
// Internal Types (Exposed for advanced use)
// ============================================================================

// Re-export key types from submodules

// Map type for use in signatures
type Map<K, V> = {
  data: list<(K, V)>,
  
  isEmpty :: bool,
  lookup :: K -> Option<V>,
  insert :: K -> V -> Map<K, V>,
  remove :: K -> Map<K, V>,
  toList :: list<(K, V)>
}

// Empty map
emptyMap :: Map<K, V>
emptyMap = { data = [], isEmpty = true, lookup = emptyLookup, insert = emptyInsert, remove = emptyRemove, toList = emptyToList }

emptyLookup _ = None
emptyInsert k v = emptyMap
emptyRemove _ = emptyMap
emptyToList = []

// ============================================================================
// Utility Functions
// ============================================================================

/**
 * Parse a value string into a Node.
 */
parseValue :: string -> Node
parseValue value = 
  if isInteger value then
    NScalar (SInt (parseInt value))
  else if isFloat value then
    NScalar (SFloat (parseFloat value))
  else if value == "true" then
    NScalar (SBool true)
  else if value == "false" then
    NScalar (SBool false)
  else if value == "null" then
    NScalar SNull
  else
    NScalar (SString value)

isInteger s = 
  if s == "" then false
  else all (\c -> c >= '0' && c <= '9') s || 
       (s[0] == '-' && all (\c -> c >= '0' && c <= '9') s[1..length(s)-1])

parseInt s = 
  if s == "" then 0
  else if s[0] == '-' then -parseInt s[1..length(s)-1]
  else foldl (\acc, c -> acc * 10 + (ord c - ord '0')) 0 s

isFloat s = contains s '.'

parseFloat s = 0.0  // Simplified

contains list elem = any (\x -> x == elem) list

ord c = charToInt c
charOfInt i = intToChar i
intToString i = 
  if i == 0 then "0"
  else if i < 0 then "-" ++ intToString (-i)
  else intToStringHelper i ""

intToStringHelper i acc = 
  if i == 0 then 
    if acc == "" then "0" else acc
  else
    intToStringHelper (i / 10) (stringOfChar (charOfDigit (i % 10)) ++ acc)

charOfDigit d = 
  if d == 0 then '0' else if d == 1 then '1' else if d == 2 then '2' 
  else if d == 3 then '3' else if d == 4 then '4' else if d == 5 then '5'
  else if d == 6 then '6' else if d == 7 then '7' else if d == 8 then '8'
  else '9'

stringOfChar c = [c]
charToInt c = 0  // Placeholder
intToChar i = ' '  // Placeholder

// List operations
foldl f acc list = 
  let rec loop acc' remaining = 
    case remaining of
      [] -> acc'
      (x :: xs) -> loop (f acc' x) xs
  in loop acc list

any pred list = 
  let rec loop remaining = 
    case remaining of
      [] -> false
      (x :: xs) -> if pred x then true else loop xs
  in loop list

all pred list = 
  let rec loop remaining = 
    case remaining of
      [] -> true
      (x :: xs) -> if pred x then loop xs else false
  in loop list

length list = 
  let rec loop acc remaining = 
    case remaining of
      [] -> acc
      (_ :: xs) -> loop (acc + 1) xs
  in loop 0 list

join sep list = 
  let rec loop acc remaining = 
    case remaining of
      [] -> acc
      [x] -> acc ++ x
      (x :: xs) -> loop (acc ++ x ++ sep) xs
  in loop "" list

repeat char n = 
  if n <= 0 then "" else char :: repeat char (n - 1)
